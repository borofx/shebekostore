<script type="application/json" id="comparison-data-{{ section.id }}">
  {
    "criteria": [
      {% for criterion in criteria %}
        {
          "label": {{ criterion.label.value | json }},
          "key": {{ criterion.metafield_key.value | json }},
          "comparison": {{ criterion.comparison.value | json }},
          "unit": {{ criterion.unit.value | json }}
        }{% unless forloop.last %}, {% endunless %}
      {% endfor %}
    ],
    "products": [
      {% for product in collection.products %}
        {
          "id": {{ product.id | json }},
          "title": {{ product.title | json }},
          "type": {{ product.type | json }},
          "values":{
            {% for criterion in criteria %}
              {% assign path = criterion.metafield_key.value | split: '.' %}
              {% assign namespace = path[0] %}
              {% assign key = path[1] %}
              {% assign metafield = product.metafields[namespace][key] %}

              {{ criterion.metafield_key.value | json }}:
              {% if metafield == blank %}
                null
              {% else %}
                {{ metafield.value | json }}
              {% endif %}
              {% unless forloop.last %},{% endunless %}
            {% endfor %}
          }
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>
